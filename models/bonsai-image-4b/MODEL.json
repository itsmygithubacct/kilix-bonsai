{
  "id": "bonsai-image-4b",
  "title": "Bonsai Image 4B",
  "summary": "Ternary and binary diffusion image models; use the wizard sizing recommendation.",
  "task": "image",
  "parameters": "4B",
  "quantization": "int2 ternary / int1 binary transformer, HQQ 4-bit text encoder",
  "license": "see LICENSE in the weight set",
  "upstream": "https://huggingface.co/collections/prism-ml/bonsai-image",
  "store": {
    "default": "$KILIX_CONTENT_ROOT/assets",
    "shared_with": "the receipt-backed Kilix Content model store"
  },
  "deps": {
    "apt": [
      "build-essential",
      "git",
      "python3-venv"
    ],
    "pip": [],
    "note": "Frozen CUDA runtime with managed Python 3.12.8 and uv 0.12.5. Use kilix wizard to accept terms and install model weights."
  },
  "runtime": {
    "kind": "image",
    "engine": "bonsai-cli",
    "cli_variant": {
      "ternary-gemlite": "ternary",
      "binary-gemlite": "binary"
    }
  },
