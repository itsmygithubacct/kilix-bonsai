{
  "id": "bonsai-image-4b",
  "title": "Bonsai Image 4B",
  "summary": "Ternary (1.58-bit) and binary (1-bit) diffusion image models. Ternary is the default: much better output for a modest size increase.",
  "task": "image",
  "parameters": "4B",
  "quantization": "int2 ternary / int1 binary transformer, HQQ 4-bit text encoder",
  "license": "see LICENSE in the weight set",
  "upstream": "https://huggingface.co/collections/prism-ml/bonsai-image",
  "store": {
    "env": "KILIX_BONSAI_BONSAI_IMAGE_4B_DIR",
    "default": "$GPU_TERMINAL_HOME/bonsai_image_generation",
    "shared_with": "the bonsai_image_generation scaffold's BONSAI_MODELS_DIR"
  },
  "deps": {
    "apt": [
      "build-essential",
      "git",
      "python3-venv"
    ],
    "pip": [],
    "note": "The gemlite/HQQ CUDA stack is large and version-sensitive, so it is resolved from the image scaffold's own lock rather than pinned a second time here. Needs an NVIDIA GPU of compute capability 7.0 or newer."
  },
