    "apt": [
      "build-essential",
      "cmake",
      "git",
      "python3-venv"
    ],
    "pip": [
      "numpy",
      "safetensors",
      "ecdsa"
    ],
    "note": "The GGUF runs under any llama.cpp-family runtime. The python packages are what a deterministic integer front end needs on top of it; nothing here builds a runtime for you."
