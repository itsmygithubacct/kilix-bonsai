{
  "id": "vibevoice-asr-bitnet",
  "title": "VibeVoice ASR BitNet",
  "summary": "Speech recognition, quantized to run in real time on CPU. This is the same weight set Kilix dictation uses, so it is stored under the voice catalog id rather than beside the other models \u2014 one copy, two front ends.",
  "task": "speech-to-text",
  "parameters": "7B base, heterogeneously quantized",
  "quantization": "I2_S + Q6_K decoder, I8_S tokenizer",
  "license": "MIT",
  "upstream": "https://huggingface.co/microsoft/VibeVoice-ASR-BitNet",
  "store": {
    "env": "KILIX_BONSAI_VIBEVOICE_DIR",
    "default": "$KILIX_DATA_HOME/voice/models/vibevoice-asr-bitnet",
    "shared_with": "kilix-voice, which resolves this exact path from the catalog id vibevoice-asr-bitnet"
  },
  "deps": {
    "apt": [
      "build-essential",
      "cmake",
      "git"
    ],
    "pip": [],
    "note": "The two GGUFs are ready to use. The safetensors variant is only needed to re-run the conversion yourself."
  },
  "runtime": {
    "kind": "speech-to-text",
    "engine": "vibeasr",
    "vae_file": "vibeasr-vae-encoder-i8_s.gguf",
    "lm_file": "vibeasr-lm-i2_s-embed-q6_k.gguf"
  },
  "variants": [
